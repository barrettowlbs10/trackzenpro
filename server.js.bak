// ==================== MIDDLEWARE AUTH ====================
function authMiddleware(req, res, next) {
  const token = req.headers.authorization?.replace('Bearer ', '');
  if (!token) return res.status(401).json({ error: 'Token necessário' });
  try {
    req.user = jwt.verify(token, JWT_SECRET);
    next();
  } catch {
    res.status(401).json({ error: 'Token inválido' });
  }
}

// ==================== ROTAS AUTH ====================
app.post('/api/auth/login', (req, res) => {
  const { email, password } = req.body;
  const user = db.prepare('SELECT * FROM users WHERE email = ?').get(email);
  if (!user || !bcrypt.compareSync(password, user.password)) {
    return res.status(401).json({ error: 'Email ou senha incorretos' });
  }
  const token = jwt.sign({ id: user.id, email: user.email, name: user.name, plan: user.plan }, JWT_SECRET, { expiresIn: '7d' });
  res.json({ token, user: { id: user.id, name: user.name, email: user.email, plan: user.plan } });
});

app.post('/api/auth/register', (req, res) => {
  const { name, email, password } = req.body;
  if (!name || !email || !password) return res.status(400).json({ error: 'Preencha todos os campos' });
  const exists = db.prepare('SELECT id FROM users WHERE email = ?').get(email);
  if (exists) return res.status(400).json({ error: 'Email já cadastrado' });
  const hash = bcrypt.hashSync(password, 10);
  const id = uuidv4();
  db.prepare('INSERT INTO users (id, name, email, password) VALUES (?, ?, ?, ?)').run(id, name, email, hash);
  const token = jwt.sign({ id, email, name, plan: 'free' }, JWT_SECRET, { expiresIn: '7d' });
  res.json({ token, user: { id, name, email, plan: 'free' } });
});

// ==================== ROTAS DASHBOARD ====================
app.get('/api/dashboard/summary', authMiddleware, (req, res) => {
  const { period = 'today' } = req.query;
  let dateFilter = '';
  const now = new Date();

  if (period === 'today') {
    const today = now.toISOString().split('T')[0];
    dateFilter = `AND date(created_at) = '${today}'`;
  } else if (period === 'yesterday') {
    const yesterday = new Date(now); yesterday.setDate(now.getDate()-1);
    dateFilter = `AND date(created_at) = '${yesterday.toISOString().split('T')[0]}'`;
  } else if (period === '7days') {
    dateFilter = `AND created_at >= datetime('now', '-7 days')`;
  } else if (period === '30days') {
    dateFilter = `AND created_at >= datetime('now', '-30 days')`;
  } else if (period === 'month') {
    dateFilter = `AND strftime('%Y-%m', created_at) = strftime('%Y-%m', 'now')`;
  }

  const sales = db.prepare(`SELECT * FROM sales WHERE user_id = ? AND status = 'approved' ${dateFilter}`).all(req.user.id);
  const revenue = sales.reduce((s, sale) => s + sale.value, 0);
  const count = sales.length;
  const avgTicket = count > 0 ? revenue / count : 0;

  const byPlatform = {};
  sales.forEach(s => {
    if (!byPlatform[s.platform]) byPlatform[s.platform] = { revenue: 0, count: 0 };
    byPlatform[s.platform].revenue += s.value;
    byPlatform[s.platform].count += s.count || 1;
  });

  const byCampaign = {};
  sales.forEach(s => {
    if (!s.campaign) return;
    if (!byCampaign[s.campaign]) byCampaign[s.campaign] = { revenue: 0, count: 0, platform: s.platform };
    byCampaign[s.campaign].revenue += s.value;
    byCampaign[s.campaign].count += 1;
  });

  const byPayment = {};
  sales.forEach(s => {
    if (!byPayment[s.payment_method]) byPayment[s.payment_method] = 0;
    byPayment[s.payment_method] += s.value;
  });

  // Vendas por hora (últimas 24h)
  const byHour = {};
  sales.forEach(s => {
    const h = new Date(s.created_at).getHours();
    if (!byHour[h]) byHour[h] = { revenue: 0, count: 0 };
    byHour[h].revenue += s.value;
    byHour[h].count += 1;
  });

  res.json({ revenue, count, avgTicket, byPlatform, byCampaign, byPayment, byHour, recentSales: sales.slice(-10).reverse() });
});

app.get('/api/sales', authMiddleware, (req, res) => {
  const { platform, limit = 100, offset = 0 } = req.query;
  let query = 'SELECT * FROM sales WHERE user_id = ?';
  const params = [req.user.id];
  if (platform) { query += ' AND platform = ?'; params.push(platform); }
  query += ' ORDER BY created_at DESC LIMIT ? OFFSET ?';
  params.push(Number(limit), Number(offset));
  const sales = db.prepare(query).all(...params);
  const total = db.prepare('SELECT COUNT(*) as c FROM sales WHERE user_id = ?').get(req.user.id).c;
  res.json({ sales, total });
});

// ==================== WEBHOOK RECEBEDOR ====================
app.post('/webhook/:platform/:userId', (req, res) => {
  const { platform, userId } = req.params;
  const data = req.body;

  let value = 0, product = '', status = 'approved', paymentMethod = 'pix', campaign = '', utmSource = '', utmMedium = '', utmCampaign = '', customerEmail = '', customerName = '';

  if (platform === 'hotmart') {
    value = data?.purchase?.original_offer_price?.value || data?.purchase?.price?.value || 0;
    product = data?.product?.name || '';
    status = data?.purchase?.status === 'APPROVED' ? 'approved' : 'pending';
    paymentMethod = data?.purchase?.payment?.type?.toLowerCase() || 'pix';
    customerEmail = data?.buyer?.email || '';
    customerName = data?.buyer?.name || '';
    utmSource = data?.tracking?.source || '';
    utmCampaign = data?.tracking?.campaign || '';
  } else if (platform === 'kiwify') {
    value = data?.order?.amount / 100 || 0;
    product = data?.product?.name || '';
    status = data?.order?.status === 'paid' ? 'approved' : 'pending';
    paymentMethod = data?.order?.payment_method || 'pix';
    customerEmail = data?.customer?.email || '';
    utmSource = data?.utm?.source || '';
    utmCampaign = data?.utm?.campaign || '';
  } else if (platform === 'monetizze') {
    value = data?.venda?.valor || 0;
    product = data?.produto?.nome || '';
    status = data?.venda?.status_nome === 'Aprovado' ? 'approved' : 'pending';
    customerEmail = data?.comprador?.email || '';
    utmSource = data?.utm_source || '';
  } else {
    value = data?.value || data?.amount || data?.total || 0;
    product = data?.product || data?.product_name || '';
    status = data?.status || 'approved';
    customerEmail = data?.email || data?.customer_email || '';
    utmSource = data?.utm_source || '';
    utmCampaign = data?.utm_campaign || '';
  }

  const user = db.prepare('SELECT id FROM users WHERE id = ?').get(userId);
  if (!user) return res.status(404).json({ error: 'Usuário não encontrado' });

  const id = uuidv4();
  db.prepare(`INSERT INTO sales (id, user_id, platform, product, value, status, payment_method, customer_email, customer_name, utm_source, utm_medium, utm_campaign) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`).run(
    id, userId, platform, product, value, status, paymentMethod, customerEmail, customerName, utmSource, utmMedium, utmCampaign
  );

  db.prepare(`INSERT INTO notifications (id, user_id, type, title, message) VALUES (?, ?, ?, ?, ?)`).run(
    uuidv4(), userId, 'sale', `Venda ${status === 'approved' ? 'aprovada' : 'pendente'}`,
    `Nova venda de R$${value.toFixed(2)} via ${platform} - ${product}`
  );

  res.json({ success: true, id });
});

