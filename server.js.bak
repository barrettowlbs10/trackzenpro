// ==================== UTMs ====================
app.get('/api/utms', authMiddleware, (req, res) => {
  const utms = db.prepare('SELECT * FROM utms WHERE user_id = ? ORDER BY created_at DESC').all(req.user.id);
  res.json(utms);
