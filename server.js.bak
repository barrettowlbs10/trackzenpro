// ==================== RELATÓRIOS ====================
app.get('/api/reports', authMiddleware, (req, res) => {
  const { period = '7days' } = req.query;
  let days = 7;
  if (period === '30days') days = 30;
  if (period === 'month') days = 30;

  const rows = [];
  for (let i = days - 1; i >= 0; i--) {
    const date = new Date();
    date.setDate(date.getDate() - i);
    const dateStr = date.toISOString().split('T')[0];
    const dayName = date.toLocaleDateString('pt-BR', { weekday: 'long' });

    const sales = db.prepare(`SELECT * FROM sales WHERE user_id = ? AND date(created_at) = ? AND status = 'approved'`).all(req.user.id, dateStr);
    const revenue = sales.reduce((s, x) => s + x.value, 0);
    const count = sales.length;

    rows.push({ date: dateStr, day: dayName, count, revenue, cpa: count > 0 ? 0 : null });
  }
  res.json(rows);
});

// ==================== USER INFO ====================
app.get('/api/user', authMiddleware, (req, res) => {
  const user = db.prepare('SELECT id, name, email, plan, created_at FROM users WHERE id = ?').get(req.user.id);
  const salesCount = db.prepare('SELECT COUNT(*) as c FROM sales WHERE user_id = ?').get(req.user.id).c;
  const pixelCount = db.prepare('SELECT COUNT(*) as c FROM pixels WHERE user_id = ?').get(req.user.id).c;
  const webhookCount = db.prepare('SELECT COUNT(*) as c FROM webhooks WHERE user_id = ?').get(req.user.id).c;
  res.json({ ...user, salesCount, pixelCount, webhookCount });
});

