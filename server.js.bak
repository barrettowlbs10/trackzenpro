app.post('/api/utms', authMiddleware, (req, res) => {
  const { name, base_url, utm_source, utm_medium, utm_campaign, utm_content, utm_term } = req.body;
  const params = new URLSearchParams();
  if (utm_source) params.set('utm_source', utm_source);
  if (utm_medium) params.set('utm_medium', utm_medium);
  if (utm_campaign) params.set('utm_campaign', utm_campaign);
  if (utm_content) params.set('utm_content', utm_content);
  if (utm_term) params.set('utm_term', utm_term);
  const full_url = `${base_url}?${params.toString()}`;
  const id = uuidv4();
  db.prepare('INSERT INTO utms (id, user_id, name, base_url, utm_source, utm_medium, utm_campaign, utm_content, utm_term, full_url) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)').run(
    id, req.user.id, name, base_url, utm_source, utm_medium, utm_campaign, utm_content || '', utm_term || '', full_url
  );
  res.json({ id, full_url });
});

app.delete('/api/utms/:id', authMiddleware, (req, res) => {
  db.prepare('DELETE FROM utms WHERE id = ? AND user_id = ?').run(req.params.id, req.user.id);
  res.json({ success: true });
});

